# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Entity Framework Migrations
# Uncomment if you want to ignore migrations
# Migrations/

# Database files
*.mdf
*.ldf
*.ndf

# SQL Server files
*.bak

# Others
launchSettings.json
*.publishsettings
*.pubxml
*.azurePubxml

# Backup & report files
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# Node modules (if using any frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
appsettings.json
